{
  "manifest_version": 3,
  "name": "법 쉽게 설명",
  "version": "1.0.0",
  "description": "텍스트를 선택하거나 문단을 클릭하면 Claude AI가 쉽게 설명해줍니다.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon.svg"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.law.go.kr/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "permissions": ["storage"],
  "host_permissions": ["https://api.anthropic.com/*"]
}
