{
  "manifest_version": 3,
  "name": "법령 핵심 문구 하이라이터",
  "version": "1.0.0",
  "description": "법제처 법령을 Claude AI로 분석하여 핵심 문구를 자동으로 굵게 강조합니다.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon.svg"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.law.go.kr/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "permissions": ["storage"],
  "host_permissions": ["https://api.anthropic.com/*"]
}
