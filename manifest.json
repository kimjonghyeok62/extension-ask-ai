{
  "manifest_version": 3,
  "name": "AI 쉬운 설명",
  "version": "2.0.0",
  "description": "어느 웹페이지에서든 텍스트를 드래그하면 Gemini·Claude로 쉽게 설명합니다.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon.svg"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "*://claude.ai/*",
        "*://gemini.google.com/*",
        "*://chatgpt.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["*://claude.ai/*"],
      "js": ["claude-inject.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://gemini.google.com/*"],
      "js": ["gemini-inject.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://www.chatgpt.com/*",
        "*://chat.openai.com/*"
      ],
      "js": ["chatgpt-inject.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "windows", "clipboardWrite"],
  "host_permissions": ["<all_urls>"]
}
